# Copy to .env, or better: run `python scripts/docker_env.py` to generate strong random values.
# Never commit .env (it is in .gitignore and .dockerignore).
#
# SQL Server "sa" password: at least 8 characters from 3 of upper/lower/digit/symbol.
# Avoid $ (compose interpolation), quotes, backslash, # and spaces.
MSSQL_SA_PASSWORD='change-me-Placeholder-1'
POSTGRES_PASSWORD='change-me-Placeholder-2'

# Host ports (published on 127.0.0.1 only)
# MSSQL_PORT=14330
# PG_PORT=54330
